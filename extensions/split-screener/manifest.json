{
    "manifestVersion": 5,
    "id": "com.splitscreener.uxp",
    "name": "Split Screener",
    "version": "1.2.0",
    "main": "index.html",
    "host": {
        "app": "premierepro",
        "minVersion": "25.6.0"
    },
    "entrypoints": [
        {
            "type": "panel",
            "id": "splitScreenerPanel",
            "label": {
                "default": "Split Screener"
            },
            "description": {
                "default": "Builds a 50/50 split screen from two congruent clips on different video tracks."
            },
            "minimumSize": {
                "width": 320,
                "height": 420
            },
            "preferredDockedSize": {
                "width": 360,
                "height": 560
            },
            "preferredFloatingSize": {
                "width": 420,
                "height": 640
            }
        }
    ],
    "icons": [
        {
            "width": 24,
            "height": 24,
            "path": "icons/icon.png",
            "scale": [
                1,
                2
            ],
            "species": [
                "pluginList"
            ]
        }
    ],
    "requiredPermissions": {
        "clipboard": "readAndWrite",
        "localFileSystem": "request"
    }
}
