{
    "manifestVersion": 5,
    "id": "com.smoothautoframe.uxp",
    "name": "Smooth Auto Frame",
    "version": "1.0.0",
    "main": "index.html",
    "host": {
        "app": "premierepro",
        "minVersion": "25.6.0"
    },
    "entrypoints": [
        {
            "type": "panel",
            "id": "smoothAutoFramePanel",
            "label": {
                "default": "Smooth Auto Frame"
            },
            "description": {
                "default": "Removes unwanted Auto Reframe camera drift from selected clips."
            },
            "minimumSize": {
                "width": 320,
                "height": 420
            },
            "preferredDockedSize": {
                "width": 360,
                "height": 560
            },
            "preferredFloatingSize": {
                "width": 400,
                "height": 620
            }
        }
    ],
    "icons": [
        {
            "width": 24,
            "height": 24,
            "path": "icons/icon.png",
            "scale": [
                1,
                2
            ],
            "species": [
                "pluginList"
            ]
        }
    ]
}
